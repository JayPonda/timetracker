{
  "name": "private-dash-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal Day Manager (PDM) — single-user day manager, runs in Docker",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm --filter @pdm/shared build && pnpm migrate && pnpm -r --parallel dev",
    "migrate": "pnpm --filter api migrate",
    "migrate:status": "pnpm --filter api migrate:status",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @pdm/shared build && tsc -b",
    "test": "pnpm --filter @pdm/shared build && vitest run",
    "test:watch": "pnpm --filter @pdm/shared build && vitest",
    "test:coverage": "pnpm --filter @pdm/shared build && vitest run --coverage",
    "test:int": "pnpm --filter @pdm/shared build && vitest run --config vitest.int.config.ts",
    "test:e2e": "playwright test",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}