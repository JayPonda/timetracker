{
  "name": "@pdm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/cli/migrate.ts",
    "migrate:status": "tsx src/cli/migrate-status.ts",
    "backup": "tsx src/cli/backup.ts",
    "restore": "tsx src/cli/restore.ts",
    "seed:dev": "tsx src/db/seed-dev.ts",
    "seed:perf": "tsx src/db/seed-perf.ts",
    "search:rebuild": "tsx src/cli/search-rebuild.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.0.3",
    "@pdm/shared": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.2.0",
    "knex": "^3.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}