# Copy to .env and edit. Never commit .env.
# Every value below is the default; the app runs with no .env at all.

# ---------------------------------------------------------------- app
# Port published on the host loopback only. Change to avoid a port clash (DEP-02, R5).
PDM_PORT=8080
# Port the container listens on inside the container. Do not change unless you also
# change the Dockerfile EXPOSE and the compose ports mapping.
PDM_INTERNAL_PORT=8080

# ---------------------------------------------------------------- runtime
# IANA time zone. The laptop clock is the source of time (A2). Durations are stored in
# UTC and rendered here (NFR-TIME-01).
TZ=Asia/Kolkata

# ---------------------------------------------------------------- logging
# How much the app says about itself, including the paths that succeeded — not just the
# failures. One level controls the whole application, and the line format never changes:
#   [2026-09-29T09:41:12.004Z] [INFO] (index.ts) (boot) listening host=0.0.0.0 port=8080
# trace  | every branch taken, including the ones that led nowhere
# debug  | what the code is doing and which way a decision went
# info   | milestones: boot, listen, backup written, migration applied, task started
# warn   | something unexpected that the app recovered from
# error  | a request failed or an operation did not complete (the stack is included)
# fatal  | the process cannot continue
# silent | print nothing at all
#
# Errors and warnings go to stderr, everything else to stdout, so `2>errors.log` works.
# `docker compose logs` shows both.
LOG_LEVEL=info

# The browser build reads VITE_LOG_LEVEL instead, because Vite only exposes
# variables with that prefix to the bundle. Set it in apps/web/.env.local.
# VITE_LOG_LEVEL=info

# ---------------------------------------------------------------- data
# There is nothing to configure here. The database and its backups live in the
# Docker-managed volumes `pdm_pdm-data` and `pdm_pdm-backups`, mounted in the
# container as /data and /backups. They are not host folders: host bind mounts
# failed intermittently on the development machine (see docker-compose.yml), and
# a volume removes that whole failure class.
#
# The database is still a plain SQLite file. To read it with any SQLite client:
#   docker compose cp pdm:/data/pdm.db ./copy.db

# ---------------------------------------------------------------- backups (DEP-07)
# Number of automatic backups to keep. Rotation deletes only backup copies, never user
# data (Q14).
PDM_BACKUP_COUNT=14
# Hour of the automatic backup in local time (24h).
PDM_BACKUP_HOUR=2

# ---------------------------------------------------------------- behaviour defaults
# Hours of day the hourly reminder is active, local time (FR-REM-05, Q3).
PDM_HOURLY_START=09
PDM_HOURLY_END=18
# Hourly reminder is on by default; the user can turn it off in Settings.
PDM_HOURLY_ENABLED=true

# ---------------------------------------------------------------- MCP server
# Published MCP port, loopback only. Set PDM_MCP_PUBLISH=false to run the MCP server
# over stdio only (`docker compose run --rm -T pdm-mcp --stdio`) and publish nothing.
PDM_MCP_PORT=8765
PDM_MCP_PUBLISH=true
# Access mode default on first start: read_only | read_create | off (MCP-17).
PDM_MCP_MODE=read_create
# Calls per minute allowed for the MCP token (MCP-19).
PDM_MCP_RATE_LIMIT=60
