# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
*.tsbuildinfo

# Runtime data (never commit user data).
#
# Since the switch to Docker-managed volumes there is no data directory in the
# working tree: the database lives in the `pdm_pdm-data` volume. These entries
# stay so a leftover folder from the earlier bind-mount setup is never committed
# by accident, and so a local `pnpm` run has somewhere to put its database.
data/
backups/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Environment
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
logs/

# Test + tooling caches
coverage/
.vitest/
playwright-report/
test-results/
.cache/

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
